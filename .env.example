# ============================================================
#  HwMon Server v5.0.1 生产部署环境变量模板
#  用法：cp .env.example .env  然后填写实际值
#  ⚠️  切勿将含真实密码的 .env 提交到 git（已在 .gitignore 中忽略）
# ============================================================

# === 服务端口 ===
SERVER_PORT=5000

# === 镜像版本标签 ===
HW_IMAGE_TAG=v5.0.1

# === 数据库（生产环境手动指定专用 MySQL）===
DB_HOST=your-production-db-host
DB_PORT=3306
DB_USER=hwmon
DB_PASSWORD=your-strong-db-password
DB_NAME=hwmon
DB_CHARSET=utf8mb4

# === Redis（生产环境手动指定专用 Redis）===
REDIS_HOST=your-production-redis-host
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-redis-password-if-any

# === 登录与安全 ===
LOGIN_USERNAME=admin
LOGIN_PASSWORD=change-me-to-a-strong-password
# 强烈建议用随机字符串，例如：openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret-key
