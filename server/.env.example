# HwMonServer 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# 数据库配置
DB_HOST=192.168.20.17
DB_PORT=3306
DB_USER=HwMon
DB_PASSWORD=your_database_password_here
DB_NAME=hwmon
DB_CHARSET=utf8mb4

# 登录配置
LOGIN_USERNAME=xapi
LOGIN_PASSWORD=your_login_password_here

# Session密钥（建议使用随机生成的字符串）
SECRET_KEY=generate_a_random_secret_key_here

# 服务器配置
SERVER_PORT=5000
SERVER_HOST=0.0.0.0

# 并发采集配置
COLLECT_MAX_WORKERS=50
COLLECT_TIMEOUT=15
COLLECT_RETRY_TIMES=0
